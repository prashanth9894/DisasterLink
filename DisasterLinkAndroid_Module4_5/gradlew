#!/bin/sh
# Lightweight Gradle wrapper launcher for DisasterLink Android.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Gradle wrapper JAR is missing: $WRAPPER_JAR"
  echo "Open Android Studio and set Gradle to the project wrapper, or install Gradle 8.9 locally and regenerate the wrapper with:"
  echo "  gradle wrapper --gradle-version 8.9"
  exit 1
fi
exec java ${JAVA_OPTS:-} ${GRADLE_OPTS:-} -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
